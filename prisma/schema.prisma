generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ListingSource {
  EDITORIAL
  USER
}

enum RentalType {
  SHORT
  LONG
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  nickname      String
  role          UserRole  @default(USER)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]
  reviews       Review[]

  @@index([email])
}

model City {
  id        String  @id @default(cuid())
  name      String  @unique
  nameEn    String
  lat       Float
  lng       Float
  zoom      Int

  listings  Listing[]
}

model Listing {
  id            String        @id @default(cuid())
  lat           Float
  lng           Float
  address       String
  buildingName  String?
  cityId        String
  city          City          @relation(fields: [cityId], references: [id])
  price         Int
  roomType      String
  rentalType    RentalType
  availableFrom DateTime?
  description   String?
  amenities     String[]
  billsIncluded Boolean       @default(false)
  photos        String[]
  contactWechat String?
  contactPhone  String?
  contactEmail  String?
  source        ListingSource
  sourceUrl     String?
  sourcePlatform String?
  status        ListingStatus @default(PENDING)
  rejectReason  String?
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  expiresAt     DateTime?

  @@index([cityId])
  @@index([status])
  @@index([lat, lng])
  @@index([price])
  @@index([rentalType])
}

model Review {
  id              String   @id @default(cuid())
  lat             Float
  lng             Float
  address         String
  buildingName    String?
  transportScore  Int
  safetyScore     Int
  valueScore      Int
  overallScore    Int
  content         String
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, lat, lng])
  @@index([lat, lng])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  type      String   // "email_verify" | "password_reset"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}
